.home-page {
  display: grid;
  gap: 20rpx;
}

.brand-card {
  display: grid;
  grid-template-columns: 84rpx 1fr;
  gap: 18rpx;
  align-items: center;
}

.brand-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #071a30, #0a6cff);
}

.brand-name {
  margin-top: 6rpx;
  color: var(--ink-color);
  font-size: 30rpx;
  font-weight: 900;
}

.hero-tags,
.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.hero-tags text {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: var(--blue-color);
  background: rgba(10, 108, 255, 0.08);
  font-size: 23rpx;
  font-weight: 800;
}

.advantage-grid,
.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.advantage-item,
.category-card {
  display: grid;
  gap: 10rpx;
  min-height: 112rpx;
  padding: 20rpx;
  border: 1rpx solid var(--line-color);
  border-radius: 20rpx;
  background: #f9fbfe;
}

.advantage-item text,
.category-card text {
  color: var(--blue-color);
  font-size: 22rpx;
  font-weight: 900;
}

.advantage-item view,
.category-card view {
  color: var(--ink-color);
  font-size: 28rpx;
  font-weight: 900;
}

.quote-guide {
  display: grid;
  gap: 16rpx;
}

.step-item {
  display: grid;
  grid-template-columns: 64rpx 1fr;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line-color);
}

.step-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.step-item > text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: var(--blue-color);
  font-size: 22rpx;
  font-weight: 900;
}

.step-item view view:first-child {
  color: var(--ink-color);
  font-size: 28rpx;
  font-weight: 900;
}

.quality-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.quality-list text {
  padding: 18rpx;
  border-radius: 18rpx;
  color: var(--ink-color);
  background: #f9fbfe;
  font-size: 24rpx;
  font-weight: 800;
}
