page {
  min-height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #eef5ff;
}

.page {
  --page-bg: linear-gradient(180deg, #f8fbff 0%, #eef5ff 100%);
  --panel-bg: #ffffff;
  --card-bg: #ffffff;
  --text-color: #10223a;
  --text-muted: #637287;
  --line-color: #e3ecf7;
  --accent-color: #ff7a1a;
  --blue-color: #0a6cff;
  --teal-color: #00a886;
  --ink-color: #071a30;
  --shadow-card: 0 12rpx 32rpx rgba(5, 23, 51, 0.1);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 128rpx;
  color: var(--text-color);
  background: var(--page-bg);
}

.card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line-color);
  border-radius: 24rpx;
  background: var(--panel-bg);
  box-shadow: var(--shadow-card);
}

.page-hero,
.hero {
  display: grid;
  gap: 18rpx;
  overflow: hidden;
  color: var(--text-color);
  background:
    radial-gradient(circle at 86% 12%, rgba(255, 122, 26, 0.18), transparent 28%),
    linear-gradient(135deg, #ffffff, #eef5ff);
}

.kicker,
.eyebrow {
  color: var(--blue-color);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.title {
  color: var(--ink-color);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.14;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  color: var(--ink-color);
  font-size: 30rpx;
  font-weight: 900;
}

.muted {
  color: var(--text-muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.link {
  color: var(--blue-color);
  font-size: 24rpx;
  font-weight: 900;
}

.primary-button,
.ghost-button,
.mini-button {
  min-height: 76rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.primary-button::after,
.ghost-button::after,
.mini-button::after {
  border: none;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, var(--accent-color), #ff9b3d);
  box-shadow: 0 14rpx 28rpx rgba(255, 122, 26, 0.24);
}

.ghost-button,
.mini-button {
  border: 1rpx solid var(--line-color);
  color: var(--ink-color);
  background: #ffffff;
}

.chip-row,
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip,
.process-chip,
.product-chip,
.tag {
  display: inline-flex;
  align-items: center;
  min-height: 58rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line-color);
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--text-color);
  font-size: 24rpx;
  font-weight: 800;
}

.chip.active,
.chip.selected,
.process-chip.active,
.product-chip.active {
  border-color: rgba(10, 108, 255, 0.32);
  color: var(--blue-color);
  background: rgba(10, 108, 255, 0.08);
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.product-tile {
  padding: 16rpx;
  border: 1rpx solid var(--line-color);
  border-radius: 22rpx;
  background: var(--card-bg);
  box-shadow: 0 10rpx 24rpx rgba(5, 23, 51, 0.06);
}

.tile-thumb,
.feature-thumb,
.hero-thumb {
  width: 100%;
  height: 150rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f7faff, #e5f0ff);
}

.tile-thumb.cover,
.feature-thumb.cover,
.hero-thumb.cover {
  display: block;
}

.tile-thumb.tone-1,
.feature-thumb.tone-1,
.hero-thumb.tone-1 {
  background: linear-gradient(135deg, #fff1df, #ffffff);
}

.tile-thumb.tone-2,
.feature-thumb.tone-2,
.hero-thumb.tone-2 {
  background: linear-gradient(135deg, #eff8f4, #ffffff);
}

.tile-name {
  margin-top: 12rpx;
  color: var(--ink-color);
  font-size: 28rpx;
  font-weight: 900;
}

.tile-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.field {
  margin-bottom: 18rpx;
}

.field text,
.field label text {
  display: block;
  margin-bottom: 8rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  font-weight: 800;
}

.field.two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.field.two label {
  display: flex;
  flex-direction: column;
}

input,
.picker-value,
textarea {
  min-height: 80rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--line-color);
  border-radius: 18rpx;
  background: #f9fbfe;
  color: var(--ink-color);
}

textarea {
  width: 100%;
  min-height: 160rpx;
  line-height: 1.6;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  color: var(--ink-color);
  font-weight: 800;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 24rpx 0;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--teal-color);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.bottom-cta {
  position: fixed;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  z-index: 20;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 48rpx rgba(5, 23, 51, 0.16);
}
